+// Styles are collected in the root occurrence's coordinate frame. A located
+// subshape is the key: stripping location would mix repeated instance colors.
+struct SourceNames { std::string product; std::string occurrence; std::string assemblyPath; };
+class SourceStyles
+{
+public:
+    NCollection_DataMap<TopoDS_Shape, Color, TopTools_ShapeMapHasher> colors;
+    NCollection_DataMap<TopoDS_Shape, SourceNames, TopTools_ShapeMapHasher> names;
+    TopTools_MapOfShape ambiguousColors;
+
+    SourceStyles (const TDF_Label& label, const Handle (XCAFDoc_ShapeTool)& shapeTool)
+    {
+        XCAFPrs_IndexedDataMapOfShapeStyle settings;
+        XCAFPrs::CollectStyleSettings (label, TopLoc_Location (), settings);
+        Paint (shapeTool->GetShape (label), settings, nullptr, 0);
+        Name (label, TopLoc_Location (), shapeTool, "/", 0);
+    }
+
+    bool ColorOf (const TopoDS_Shape& shape, Color& color) const
+    {
+        if (ambiguousColors.Contains (shape) || !colors.IsBound (shape)) return false;
+        color = colors.Find (shape);
+        return true;
+    }
+    SourceNames NamesOf (const TopoDS_Shape& shape) const
+    {
+        return names.IsBound (shape) ? names.Find (shape) : SourceNames {};
+    }
+
+private:
+    void Paint (const TopoDS_Shape& shape, const XCAFPrs_IndexedDataMapOfShapeStyle& settings, const Color* inherited, int depth)
+    {
+        if (shape.IsNull () || depth > 128) return;
+        Color own;
+        const Color* selected = inherited;
+        const int index = settings.FindIndex (shape);
+        if (index != 0 && settings.FindFromIndex (index).IsSetColorSurf ()) {
+            const Quantity_Color& color = settings.FindFromIndex (index).GetColorSurf ();
+            own = Color (color.Red (), color.Green (), color.Blue ());
+            selected = &own;
+        }
+        // Mesh consumers only ask about solids/shells/faces. Shared edges and
+        // vertices may inherit different adjacent colors and need no entry.
+        if (selected != nullptr && (shape.ShapeType () == TopAbs_SOLID || shape.ShapeType () == TopAbs_SHELL || shape.ShapeType () == TopAbs_FACE)) {
+            if (!ambiguousColors.Contains (shape)) {
+                if (!colors.IsBound (shape)) colors.Bind (shape, *selected);
+                else {
+                    const Color& old = colors.Find (shape);
+                    if (old.r != selected->r || old.g != selected->g || old.b != selected->b) {
+                        colors.UnBind (shape);
+                        ambiguousColors.Add (shape);
+                    }
+                }
+            }
+        }
+        if (shape.ShapeType () != TopAbs_FACE) for (TopoDS_Iterator it (shape); it.More (); it.Next ()) Paint (it.Value (), settings, selected, depth + 1);
+    }
+
+    void Name (const TDF_Label& label, const TopLoc_Location& parent, const Handle (XCAFDoc_ShapeTool)& shapeTool, const std::string& assemblyPath, int depth)
+    {
+        if (depth > 128) return;
+        TDF_Label product = label;
+        if (shapeTool->IsReference (label) && !shapeTool->GetReferredShape (label, product)) return;
+        const TopoDS_Shape placed = shapeTool->GetShape (label).Moved (parent);
+        TDF_LabelSequence children;
+        if (shapeTool->GetComponents (product, children, false)) {
+            const TopLoc_Location location = parent * shapeTool->GetLocation (label);
+            for (int i = 1; i <= children.Length (); ++i) Name (children.Value (i), location, shapeTool, assemblyPath + std::to_string (label.Tag ()) + "/", depth + 1);
+            return;
+        }
+        const SourceNames source { GetLabelNameNoRef (product), shapeTool->IsReference (label) ? GetLabelNameNoRef (label) : std::string (), assemblyPath };
+        if (source.product.empty () && source.occurrence.empty ()) return;
+        for (TopAbs_ShapeEnum kind : { TopAbs_SOLID, TopAbs_SHELL }) {
+            for (TopExp_Explorer it (placed, kind); it.More (); it.Next ()) {
+                const TopoDS_Shape& shape = it.Current ();
+                if (!names.IsBound (shape)) names.Bind (shape, source);
+                else {
+                    SourceNames& existing = names.ChangeFind (shape);
+                    if (existing.product != source.product) existing.product.clear ();
+                    if (existing.occurrence != source.occurrence) existing.occurrence.clear ();
+                    if (existing.assemblyPath != source.assemblyPath) existing.assemblyPath.clear ();
+                }
+            }
+        }
+    }
+};
