exports[`golden schematics > xlr-mic-cable matches its golden drawing 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 339.08 170.2" width="339.08mm" height="170.2mm" role="img" aria-label="XLR female → XLR male, balanced microphone cable, 5 m" data-design="xlr-mic-cable">
<title>XLR female → XLR male, balanced microphone cable, 5 m</title>
<desc>Wiring schematic for xlr-mic-cable.</desc>
