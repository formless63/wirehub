exports[`golden schematics > de9-terminal-board matches its golden drawing 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 350.5 175.2" width="350.5mm" height="175.2mm" role="img" aria-label="DE-9 → terminal adapter board, terminated pair" data-design="de9-terminal-board">
<title>DE-9 → terminal adapter board, terminated pair</title>
