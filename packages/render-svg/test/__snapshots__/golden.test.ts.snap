exports[`golden schematics > dc-y-from-leads matches its golden drawing 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 393.03 186.95" width="393.03mm" height="186.95mm" role="img" aria-label="Terminal block → 2 × JST XH 2-pin, DC Y built from two pigtail leads" data-design="dc-y-from-leads">
