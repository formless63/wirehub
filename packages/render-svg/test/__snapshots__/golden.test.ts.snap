exports[`golden schematics > db9-null-modem matches its golden drawing 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 345.18 205.2" width="345.18mm" height="205.2mm" role="img" aria-label="DE-9 RS-232 → DE-9 RS-232, null modem (3-wire, local handshake loopback)" data-design="db9-null-modem">
<title>DE-9 RS-232 → DE-9 RS-232, null modem (3-wire, local handshake loopback)</title>
<desc>Wiring schematic for db9-null-modem.</desc>
