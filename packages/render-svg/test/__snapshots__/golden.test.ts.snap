exports[`golden schematics > dc-y-splitter matches its depicted golden drawing 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 462.89 208.3" width="462.89mm" height="208.3mm" role="img" aria-label="Terminal block → moulded Y → 2× JST XH, two-channel DC splitter" data-design="dc-y-splitter">
