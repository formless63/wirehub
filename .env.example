# WireHub settings. `bash scripts/setup-env.sh` copies this file to .env and
# fills in every secret marked GENERATED; edit the rest to taste. .env is
# gitignored — never commit it. Every variable is read by compose.yaml (and
# compose.backup.yaml); the app reads the ones it is handed.

# --- the app -------------------------------------------------------------
# image to run; `docker compose build` builds it locally under this name
WIREHUB_IMAGE=ghcr.io/formless63/wirehub:edge
# host address and port the app is published on. 127.0.0.1 keeps it on this
# machine; use 0.0.0.0 (behind a TLS proxy) to serve a network
WIREHUB_BIND=127.0.0.1
WIREHUB_PORT=5183
# container time zone (log timestamps, backup schedule)
TZ=UTC

# --- blob storage (uploaded photos, datasheets, 3D models) -----------------
# s3: the bundled Garage (default) or any S3-compatible service
# fs:/data/blobs: a volume instead — the fallback without object storage
#   (then start only the app: docker compose up -d --no-deps wirehub)
STUDIO_BLOBS=s3
# leave these for the bundled Garage; point them elsewhere for AWS S3, MinIO,
# RustFS, Backblaze B2, Cloudflare R2 … (path-style addressing is used)
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=wirehub
# the app's key (Garage key ids are GK + 24 hex digits, secrets 64 hex digits)
S3_ACCESS_KEY_ID=            # GENERATED
S3_SECRET_ACCESS_KEY=        # GENERATED
# a read-only key on the same bucket, used by the backup mirror
S3_BACKUP_ACCESS_KEY_ID=     # GENERATED
S3_BACKUP_SECRET_ACCESS_KEY= # GENERATED

# --- Garage (the bundled S3 store) ------------------------------------------
GARAGE_RPC_SECRET=           # GENERATED (64 hex digits)
GARAGE_ADMIN_TOKEN=          # GENERATED
# space Garage may use on this machine (K, M, G, T; powers of 1000)
GARAGE_CAPACITY=100G

# --- PostgreSQL 18 ----------------------------------------------------------
# Provisioned for the upcoming database backend (specs/postgres-backend.md);
# WireHub does not use it yet.
POSTGRES_PASSWORD=           # GENERATED

# --- sign-in (apps/studio/README.md, "Auth") --------------------------------
# off by default: anyone who can reach the port can edit. Turn it on before
# exposing WireHub beyond this machine.
AUTH_ENABLED=false
BETTER_AUTH_SECRET=          # GENERATED
# the public origin people open WireHub at
BETTER_AUTH_URL=http://localhost:5183
# who may sign in (comma-separated)
# AUTH_ALLOWED_EMAILS=you@example.com
# OIDC sign-in (any compliant provider); redirect URI to register:
#   <BETTER_AUTH_URL>/api/auth/callback/<AUTH_OIDC_PROVIDER_ID>
# AUTH_OIDC_ISSUER=https://id.example.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_SCOPES=openid email profile
# AUTH_OIDC_EMAIL_CLAIM=email
# AUTH_OIDC_PROVIDER_ID=oidc
# AUTH_OIDC_NAME=Single sign-on
# magic-link sign-in over SMTP:
# AUTH_SMTP_HOST=
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM=wirehub@example.com

# --- who a hub without sign-in names in versions and the audit log ----------
# STUDIO_LOCAL_USER=Workshop

# --- optional git export of saves (apps/studio/server/backup) ----------------
# Needs a git checkout of the catalog mounted at STUDIO_GIT_DIR.
# STUDIO_GIT_AUTOCOMMIT=true
# STUDIO_GIT_DIR=/repo
# STUDIO_GIT_REMOTE=origin
# STUDIO_GIT_BRANCH=main

# --- backups (compose.backup.yaml) ------------------------------------------
# Backrest's web UI
BACKREST_BIND=127.0.0.1
BACKREST_PORT=9898
# daily pg_dump time (HH:MM, TZ above) and how many dumps to keep locally
BACKUP_DUMP_AT=02:30
BACKUP_KEEP_DUMPS=7
# seconds between mirrors of the bucket
BACKUP_MIRROR_INTERVAL=3600
