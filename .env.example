# WireHub settings — all optional. The stack runs with no .env at all: the
# bootstrap service generates every secret into the `secrets` volume on first
# run. Copy this file to .env (or paste the lines you need into your Docker
# UI's environment box) only to change something. Every line is commented
# out; uncomment and edit. The config generator writes a ready .env for you:
# https://formless63.github.io/wirehub/
#
# compose.yaml reads these. Never commit a .env with secrets in it.

# --- optional parts ------------------------------------------------------
# Profiles to start beside the default stack (app + Postgres + Garage),
# comma-separated:
#   backup   restic backups through Backrest (see "backups" below)
# COMPOSE_PROFILES=backup

# --- the app -------------------------------------------------------------
# The image. Pinned to the release this compose.yaml came from; set a newer
# tag to upgrade, or a locally built image (docs/self-hosting.md, development).
# WIREHUB_IMAGE=ghcr.io/formless63/wirehub:0.1.0 # x-release-please-version
# The address people open WireHub at (sign-in links and the setup banner use it).
# Behind a reverse proxy: https://wirehub.example.com
# WIREHUB_PUBLIC_URL=http://localhost:5183
# Host address and port the app is published on. 127.0.0.1 keeps it on this
# machine; 0.0.0.0 serves your network (put a TLS proxy in front).
# WIREHUB_BIND=127.0.0.1
# WIREHUB_PORT=5183
# Container time zone (log timestamps, the backup schedule).
# TZ=UTC
# Domain modules to pre-tick at first-run setup (you still decide there):
# pc-serial, networking, pro-audio, av-video, automotive.
# WIREHUB_SUGGESTED_MODULES=pc-serial,networking
# Storage backend: pg (the default) keeps the catalog, designs, versions,
# accounts and the history of every save in PostgreSQL; files keeps them as
# JSON in the `catalog` volume (a small single-user hub; with
# WIREHUB_ENV=prod it also needs WIREHUB_ALLOW_FILES_IN_PROD=1).
# WIREHUB_BACKEND=pg
# WIREHUB_ALLOW_FILES_IN_PROD=
# The organisation this hub serves, when the database holds more than one.
# WIREHUB_ORG=
# prod (default) or dev: a development copy shows a DEV badge, and refuses to
# start when its database or bucket matches a production marker below
# (comma-separated pieces of production's database host/name and bucket).
# WIREHUB_ENV=prod
# WIREHUB_PROD_MARKERS=
# Behind a reverse proxy you trust (Caddy, Traefik, nginx): 1 makes the
# studio read X-Forwarded-For / -Proto / -Host (client addresses for rate
# limits, the address people opened). Leave unset otherwise.
# WIREHUB_TRUST_PROXY=1
# Who a hub without sign-in names in versions and the audit log.
# WIREHUB_LOCAL_USER=Workshop

# --- secrets (generated by the bootstrap service) -------------------------
# Leave these unset and they are generated once and kept in the `secrets`
# volume. Set one to choose it yourself; an explicit value always wins (and
# is written to the volume). scripts/setup-env.sh fills them in for you.
# POSTGRES_PASSWORD=
# BETTER_AUTH_SECRET=
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=
# The one-time code /setup asks for; printed in the wirehub service's log.
# WIREHUB_SETUP_CODE=

# --- your own PostgreSQL (instead of the bundled one) ----------------------
# Delete the "bundled-postgres" blocks from compose.yaml, then:
# An admin connection (a role that may create roles and the database): the
# migrate service creates WireHub's roles (studio_owner, studio_app, studio_ro)
# through it, and their connections are derived from it.
# DATABASE_ADMIN_URL=postgres://postgres:password@db.example.com:5432/wirehub
# Or give each connection yourself (a managed database without a superuser):
# DATABASE_OWNER_URL=
# DATABASE_URL=
# The roles' passwords (generated when unset):
# WIREHUB_OWNER_PASSWORD=
# WIREHUB_APP_PASSWORD=
# WIREHUB_RO_PASSWORD=

# --- uploaded files: S3-compatible storage --------------------------------
# s3: the bundled Garage (default) or your own S3; fs:/data/blobs: a volume
# instead (the fallback without object storage).
# WIREHUB_BLOBS=s3
# Your own S3 (AWS, MinIO, RustFS, Backblaze B2, Cloudflare R2 …; path-style
# addressing): delete the "bundled-s3" blocks from compose.yaml, then set:
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=wirehub
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# A read-only key for the backup mirror (else the app's key is used):
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
# With the bundled Garage, its keys are created by Garage and kept in the
# `secrets` volume; set the four S3_*KEY* variables only to import your own.
# Space Garage may use (K, M, G, T; powers of 1000):
# GARAGE_CAPACITY=100G

# --- background jobs: the worker service (docs/self-hosting.md, "Jobs") ----
# off: the app runs the jobs itself (then remove the worker service from
# compose.yaml, and give the app the worker's memory for STEP conversion).
# WIREHUB_WORKER=off
# Build imported 3D models only in this window (container time; TZ):
# WIREHUB_CONVERT_WINDOW=01:00-06:00
# A STEP conversion that needs more than this (MB) is refused, inside the
# worker's 1.5 GiB cap:
# WIREHUB_STEP_RSS_LIMIT_MB=1280
# Alerts (a stale backup, models that could not be built) as a JSON POST:
# WIREHUB_NOTIFY_URL=https://ntfy.example.com/wirehub
# The folder imported models are built from (mount it into the worker):
# WIREHUB_MODEL_SOURCES=/data/model-sources

# --- sign-in (apps/studio/README.md, "Auth") --------------------------------
# On by default: first-run setup (/setup) makes the admin's email + password
# account; the admin invites everyone else (People, in the studio's rail).
# false lets anyone who can reach the port edit — only on a machine nobody
# else reaches.
# AUTH_ENABLED=true
# Email + password accounts (on by default with the database backend). Off
# when everyone signs in with OIDC below.
# AUTH_LOCAL_ACCOUNTS=true
# Extra emails that may sign in without an invitation (comma-separated),
# with the editor role. The admin is made at /setup, which asks for the setup
# code from the log, so nobody can claim a new hub before you; a hub nobody
# owns yet (one moved over from file storage) asks the same at /setup.
# AUTH_ALLOWED_EMAILS=you@example.com
# OIDC (any compliant provider). Redirect URI to register:
#   <WIREHUB_PUBLIC_URL>/api/auth/callback/<AUTH_OIDC_PROVIDER_ID>
# AUTH_OIDC_ISSUER=https://id.example.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_SCOPES=openid email profile
# AUTH_OIDC_EMAIL_CLAIM=email
# AUTH_OIDC_PROVIDER_ID=oidc
# AUTH_OIDC_NAME=Single sign-on
# Magic-link sign-in over SMTP:
# AUTH_SMTP_HOST=
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM=wirehub@example.com

# --- backups (COMPOSE_PROFILES=backup) --------------------------------------
# Where restic keeps snapshots. Unset: a repository in the `restic_repo`
# volume on this machine — it protects against mistakes, not against losing
# the disk. Set one elsewhere: rest:https://user:pass@nas.example:8000/wirehub,
# s3:https://s3.example.com/bucket/wirehub, sftp:user@host:/srv/wirehub …
# Read at first start only; afterwards change it in Backrest's UI.
# BACKUP_REPOSITORY=
# The repository's password. Unset: generated and kept in the `secrets`
# volume — copy it somewhere safe, a backup cannot be restored without it.
# Required to use an existing repository.
# BACKUP_REPOSITORY_PASSWORD=
# Credentials for an s3: repository.
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# When snapshots run (cron: minute hour day month weekday).
# BACKUP_SCHEDULE=0 3 * * *
# Daily pg_dump time (HH:MM, TZ above) and how many dumps to keep locally.
# The dump connects as the read-only role studio_ro.
# BACKUP_DUMP_AT=02:30
# BACKUP_KEEP_DUMPS=7
# The weekly restore check (0-6, 0 = Sunday): the newest dump restored into a
# scratch database and its row counts compared.
# BACKUP_CHECK_DAY=0
# Seconds between mirrors of the bucket.
# BACKUP_MIRROR_INTERVAL=3600
# Backrest's web UI.
# BACKREST_BIND=127.0.0.1
# BACKREST_PORT=9898
