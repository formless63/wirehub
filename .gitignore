# --- dependencies and build output ----------------------------------------
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.turbo/
.cache/
.pnpm-store/
.eslintcache

# --- secrets and local configuration --------------------------------------
# .env holds credentials (see .env.example); never committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# private terms for scripts/privacy-check.sh (see CONTRIBUTING.md)
.privacy-terms

# --- OS and editor files --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.#*
.claude/settings.local.json

# --- logs -----------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*

# --- local runtime data ---------------------------------------------------
# the login's local state (SQLite sessions, save audit log); the directory is
# kept so a bind mount lands on a host-user-owned folder
data/auth/*
!data/auth/.gitkeep
# docker compose bind-mount fallbacks and local volume folders
data/blobs/
data/postgres/
data/backups/
data/s3/
data/garage/
volumes/
# local catalogs: a deployment's own catalog kept beside the checkout
data/catalog/
catalogs/
# installed catalog packs and the record of first-run setup: a checkout keeps
# them in data/packs/ (WIREHUB_PACKS_DIR), layered under the starter catalog,
# so domain records never reach the generic base by accident. The other lines
# are where a hub from before the packs directory put them.
data/packs/
packages/catalog/data/packs/
packages/catalog/data/packs.json
packages/catalog/data/setup.json

# what the running studio writes that is not catalog truth: in-flight temp
# files of writeFileAtomic and the importer
.*.tmp
*.import-tmp

# --- model caches ---------------------------------------------------------
# GLBs built by an importer; data/models.json is the committed truth
packages/catalog/data/.model-cache/
# KiCad's 3D library, only the files a link needs, fetched at a pinned tag
packages/catalog/data/.kicad-3d-cache/
.model-cache/

# --- beads / Dolt (added by bd init) --------------------------------------
.dolt/
*.db
.beads-credential-key

# --- brand previews (apps/studio/scripts/brand-icons.mjs --preview) --------
brand/.preview-*.png
